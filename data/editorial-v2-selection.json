      "actor": "astra-b2c-review-a",
      "kind": "agent",
      "reviewedAt": "2026-09-08T11:58:00.000Z",
      "rationale": "Les douze voisins contiennent trois indices français distincts, naturels et utiles : firmament, rougeoyant et nuages. Ils évoquent la cible sans la reproduire ni en donner une flexion ; les variantes de ciel, les formes bruitées et les anglicismes sont écartés.",
      "evidenceSha256": "877b17c9c5dc86004ee469d03d3ed97425186bd47cd25a2d235a902160209e67"
    },
    {
      "targetId": 2069,
      "decision": "rejected",
      "hints": [],
